# ─────────────────────────────────────────────────────────────
# ReservaPrimero — variables de entorno (ver CLAUDE.md §13)
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA pongas valores reales aquí ni commitees .env.local
# ─────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API → service_role (SECRETO, solo server-side)
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (suscripción SaaS negocio → Carlos) ──────────────
# Developers → API keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Developers → Webhooks → signing secret del endpoint /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# ── Resend (email transaccional) ───────────────────────────
RESEND_API_KEY=
# Remitente verificado en Resend, ej. "ReservaPrimero <reservas@reservaprimero.com>"
RESEND_FROM_EMAIL=

# ── WhatsApp (Cloud API de Meta) — ver DEPLOY.md §6 ────────
# Token permanente de un usuario de sistema (SECRETO)
WHATSAPP_ACCESS_TOKEN=
# WhatsApp → API Setup → Phone number ID (no es el número de teléfono)
WHATSAPP_PHONE_NUMBER_ID=
# Idioma de las plantillas aprobadas (por defecto "es")
WHATSAPP_TEMPLATE_LANG=

# ── Cloudflare Turnstile (anti-spam formulario público) ────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Notificaciones push al equipo (Web Push) ───────────────
# Genera el par una vez: npx web-push generate-vapid-keys
# Si cambian, todos los dispositivos tienen que volver a activarlas.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios push (URL https o mailto:)
VAPID_SUBJECT=https://reservaprimero.com

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secreto compartido para autenticar los Vercel Cron jobs (genera uno aleatorio)
CRON_SECRET=
